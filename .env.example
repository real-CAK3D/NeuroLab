NODE_ENV=development
FRONTEND_PORT=3005
BACKEND_PORT=3006
WEBSOCKET_PORT=3007
AI_PORT=3008
MONITOR_PORT=3009
DATABASE_PATH=/data/neurolab.sqlite
SIMULATION_TICK_MS=3000
RENDER_TICK_MS=16
INFRASTRUCTURE_POLLING_MS=10000
AI_REPORT_GENERATION_MS=30000
ADMIN_TOKEN=dev-admin-token
WEBSOCKET_URL=http://neurolab-websocket:3007
LOG_LEVEL=info

# Local read-only Networking root bind for Docker Compose.
# Override this in ignored .env on CAK3D machines, e.g. C:/Users/.../Networking.
NEUROLAB_NETWORKING_ROOT=./local/networking

# Extra host names the frontend accepts (comma separated). *.ts.net and localhost are always allowed.
NEUROLAB_ALLOWED_HOSTS=

# Optional: require "Authorization: Bearer <token>" for every write (POST) call. Leave empty for open writes on the tailnet.
# The browser reads it from localStorage: localStorage.setItem("neurolab.token", "<token>")
NEUROLAB_WRITE_TOKEN=
# Hourly boss debriefs use Ollama. Defaults to the smallest installed model if empty.
NEUROLAB_REPORT_MODEL=
